{
  "name": "@dcl-editor/web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "The editor's web target: the editor UI as one ES module (editor.js) that a page already running the engine loads and mounts, plus the files it serves next to it (in-browser build, editor scene).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run build && node validate/smoke.mjs",
    "validate:assistant": "npm run build && node validate/smoke.mjs --assistant-only",
    "validate:preview": "node validate/preview.mjs"
  },
  "dependencies": {
    "@dcl-editor/contract": "*",
    "@dcl-editor/ui": "*",
    "@dcl-editor/web-build": "*",
    "@fontsource-variable/inter": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@dcl/crypto": "^3.7.0",
    "@dcl/hashing": "^1.1.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.24.2",
    "playwright-core": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
